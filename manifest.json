{
  "manifest_version": 3,
  "name": "Procodrr Dark Mode",
  "version": "1.0",
  "description": "Dark mode for procodrr.com",
    "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
  "default_icon": {
    "16": "icons/icon16.png",
    "24": "icons/icon24.png",
    "32": "icons/icon32.png"
  }
},
  "content_scripts": [
    {
      "matches": ["https://procodrr.com/*","https://app.procodrr.com/*"],
      "css": ["dark.css"],
      "js": ["content.js"]
    }
  ]
}